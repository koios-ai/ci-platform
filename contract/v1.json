{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/koios-ai/ci-platform/blob/main/contract/v1.json",
  "title": "Koios CI Platform workflow contract v1",
  "description": "Closed input boundary for the immutable reusable final CI core.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "head_sha",
    "base_sha",
    "changed_files_digest",
    "python_version",
    "artifact_retention_days"
  ],
  "properties": {
    "profile": {
      "type": "string",
      "enum": [
        "baseline",
        "python",
        "node",
        "powershell",
        "critical-ml"
      ]
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "changed_files_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "python_version": {
      "type": "string",
      "pattern": "^3\\.(?:11|12|13)$",
      "default": "3.12"
    },
    "artifact_retention_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7,
      "default": 3
    }
  },
  "x-outputs": {
    "head_sha": {
      "type": "string"
    },
    "profile": {
      "type": "string"
    },
    "deterministic_passed": {
      "type": "boolean"
    },
    "coverage_passed": {
      "type": "boolean"
    },
    "security_passed": {
      "type": "boolean"
    },
    "evidence_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
