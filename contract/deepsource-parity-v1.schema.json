  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "template_status",
    "source_config_sha",
    "hosted_inventory_artifact",
    "hosted_inventory_observed_at",
    "profiles",
    "signals",
    "disposition_preconditions"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "template_status": {"enum": ["blocked", "complete"]},
    "repository": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "source_config_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "source_config_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "evidence_root": {"type": ["string", "null"], "minLength": 1},
    "source_config_receipt": {"anyOf": [{"$ref": "#/$defs/receipt"}, {"type": "null"}]},
    "canary_execution_attestation": {
      "description": "RSA-signed canonical execution payload. Its item_canaries set must exactly equal the hosted static-rule and SCA capability inventories and bind each item to its owner/tool/version/config, command, fixture, captured output, diagnostic digest, nonzero exit, execution time, and parent negative proof.",
      "anyOf": [{"$ref": "#/$defs/receipt"}, {"type": "null"}]
    },
    "hosted_inventory_artifact": {"anyOf": [{"$ref": "#/$defs/receipt"}, {"type": "null"}]},
    "hosted_inventory_observed_at": {"type": ["string", "null"]},
    "profiles": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["baseline", "python", "node", "powershell", "critical-ml"]}
    },
    "signals": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/signal"}
    },
    "disposition_preconditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all_signals_proven", "live_ruleset_safe", "app_subscription_readbacks"],
      "properties": {
        "all_signals_proven": {"type": "boolean"},
        "live_ruleset_safe": {"anyOf": [{"$ref": "#/$defs/receipt"}, {"type": "null"}]},
        "app_subscription_readbacks": {"anyOf": [{"$ref": "#/$defs/receipt"}, {"type": "null"}]}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"template_status": {"const": "complete"}}, "required": ["template_status"]},
      "then": {
        "required": [
          "repository",
          "source_config_digest",
          "evidence_root",
          "source_config_receipt",
          "canary_execution_attestation"
        ],
        "properties": {
          "repository": {"type": "string"},
          "source_config_sha": {"type": "string"},
          "source_config_digest": {"type": "string"},
          "evidence_root": {"type": "string"},
          "source_config_receipt": {"$ref": "#/$defs/receipt"},
          "canary_execution_attestation": {"$ref": "#/$defs/receipt"},
          "hosted_inventory_artifact": {"$ref": "#/$defs/receipt"},
          "hosted_inventory_observed_at": {"type": "string"},
          "signals": {"items": {"$ref": "#/$defs/completeSignal"}},
          "disposition_preconditions": {
            "properties": {
              "all_signals_proven": {"const": true},
              "live_ruleset_safe": {"$ref": "#/$defs/receipt"},
              "app_subscription_readbacks": {"$ref": "#/$defs/receipt"}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "signal": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "parity_status", "outcome", "gaps"],
      "properties": {
        "id": {
          "enum": [
            "python-static-quality",
            "ruff-transformer",
            "sca",
            "secrets",
            "docker-compose-config",
            "adapter-integrity",
            "ai-review-readback",
            "coverage"
          ]
        },
        "parity_status": {"enum": ["blocked", "gap", "proven"]},
        "outcome": {
          "description": "A complete non-AI signal may be retained for fixed-price unique defense or replaced after proven parity; usage-priced AI Review is disable-only.",
          "enum": [
            "retain-unique-defense-in-depth",
            "replace-proven-duplicate",
            "disable-usage-based-ai",
            "blocked"
          ]
        },
        "gaps": {"type": "array", "items": {"type": "string"}}
      }
    },
    "completeSignal": {
      "allOf": [
        {"$ref": "#/$defs/signal"},
        {
          "type": "object",
          "required": [
            "central_owner",
            "command",
            "pinned_tool_version",
            "pinned_config_digest",
            "scope",
            "positive_canary",
            "negative_canary",
            "hosted_inventory"
          ],
          "properties": {
            "parity_status": {"const": "proven"},
            "gaps": {"maxItems": 0},
            "central_owner": {"type": "string", "minLength": 1},
            "command": {"type": "string", "minLength": 1},
            "pinned_tool_version": {"type": "string", "minLength": 1},
            "pinned_config_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "scope": {"type": "string", "minLength": 1},
            "positive_canary": {"$ref": "#/$defs/receipt"},
            "negative_canary": {"$ref": "#/$defs/receipt"},
            "hosted_inventory": {"$ref": "#/$defs/receipt"}
          }
        },
        {
          "if": {"properties": {"id": {"const": "python-static-quality"}}},
          "then": {
            "required": ["rule_ids", "severity_threshold", "quality_threshold"],
            "properties": {
              "rule_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {"const": "python-static-quality"},
              "outcome": {"const": "replace-proven-duplicate"}
            },
            "required": ["id", "outcome"]
          },
          "then": {
            "required": ["rule_mappings"],
            "properties": {
              "rule_mappings": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"$ref": "#/$defs/replacementMapping"}
              }
            }
          }
        },
        {
          "if": {"properties": {"id": {"const": "ruff-transformer"}}},
          "then": {
            "required": ["transformer_version", "ruff_version", "config_digest"],
            "properties": {"config_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
          }
        },
        {
          "if": {"properties": {"id": {"const": "sca"}}},
          "then": {
            "required": ["manifests", "canonical_constraints", "optional_conda_surfaces"],
            "properties": {
              "canonical_constraints": {"type": "string", "minLength": 1},
              "optional_conda_surfaces": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "present"],
                  "properties": {
                    "path": {"type": "string", "minLength": 1},
                    "present": {"type": "boolean"}
                  }
                }
              },
              "manifests": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "profiles", "resolved_graph", "sbom"],
                  "properties": {
                    "path": {"type": "string", "minLength": 1},
                    "profiles": {"type": "array", "minItems": 1, "uniqueItems": true},
                    "resolved_graph": {"$ref": "#/$defs/receipt"},
                    "sbom": {"$ref": "#/$defs/receipt"}
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {"const": "sca"},
              "outcome": {"const": "replace-proven-duplicate"}
            },
            "required": ["id", "outcome"]
          },
          "then": {
            "required": ["capability_mappings"],
            "properties": {
              "capability_mappings": {
                "type": "array",
                "minItems": 5,
                "maxItems": 5,
                "uniqueItems": true,
                "items": {"$ref": "#/$defs/replacementMapping"}
              }
            }
          }
        },
        {
          "if": {"properties": {"id": {"const": "secrets"}}},
          "then": {
            "required": ["scan_scope", "provider_trigger_gaps"],
            "properties": {
              "scan_scope": {"type": "array", "minItems": 1},
              "provider_trigger_gaps": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true}
            }
          }
        },
        {
          "if": {"properties": {"id": {"const": "docker-compose-config"}}},
          "then": {
            "required": ["config_scope"],
            "properties": {"config_scope": {"type": "array", "minItems": 1}}
          }
        },
        {
          "if": {"properties": {"id": {"const": "adapter-integrity"}}},
          "then": {
            "required": ["adapter_contract_digest", "hosted_app"],
            "properties": {
              "adapter_contract_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "hosted_app": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "slug"],
                "properties": {
                  "id": {"type": "integer", "minimum": 1},
                  "slug": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"id": {"const": "ai-review-readback"}}},
          "then": {
            "required": [
              "app_readback",
              "subscription_readback",
              "target_readback",
              "enabled_readback",
              "disabled_readback"
            ],
            "properties": {
              "outcome": {"const": "disable-usage-based-ai"},
              "app_readback": {"$ref": "#/$defs/receipt"},
              "subscription_readback": {"$ref": "#/$defs/receipt"},
              "target_readback": {"$ref": "#/$defs/receipt"},
              "enabled_readback": {"const": false},
              "disabled_readback": {"const": true}
            }
          }
        },
        {
          "if": {"properties": {"id": {"not": {"const": "ai-review-readback"}}}},
          "then": {
            "properties": {
              "outcome": {
                "enum": ["retain-unique-defense-in-depth", "replace-proven-duplicate"]
              }
            }
          }
        },
        {
          "if": {"properties": {"id": {"const": "coverage"}}},
          "then": {"required": ["applicable"], "properties": {"applicable": {"type": "boolean"}}}
        }
      ]
    },
    "replacementMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_item_id", "central_owner", "negative_canary"],
      "properties": {
        "provider_item_id": {"type": "string", "minLength": 1},
        "central_owner": {"type": "string", "minLength": 1},
        "negative_canary": {
          "description": "Per-item execution receipt whose complete semantic payload must exactly equal the corresponding RSA-signed item_canaries entry; recomputing ordinary receipt hashes cannot authorize replacement.",
          "$ref": "#/$defs/receipt"
        }
      }
    }
  }
}
