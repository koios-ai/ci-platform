{
  "schema_version": 1,
  "tool_version": "1.0.0",
  "max_file_bytes": 2000000,
  "patterns": [
    {
      "name": "private-key",
      "regex": "-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----"
    },
    {
      "name": "github-token",
      "regex": "\\b(?:gh[oprsu]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,})\\b"
    },
    {
      "name": "aws-access-key",
      "regex": "\\b(?:AKIA|ASIA)[A-Z0-9]{16}\\b"
    },
    {
      "name": "openai-key",
      "regex": "\\bsk-(?:proj-)?[A-Za-z0-9_-]{20,}\\b"
    }
  ]
}
